#!/usr/bin/env bash
# Runs on the workstation, with `gh` logged in as an admin of the target repos. Drives the
# runner host over SSH: each registration token comes from `gh api` right before it is used
# and is piped straight into the container on the host, so no token or PAT lives there.
#
#   gh-runner setup                       # installs Docker on the host, copies the files, builds
#   gh-runner add <owner/repo> [count]    # adds runners to a repo (default: 1)
#   gh-runner remove <owner/repo> [index] # removes one runner, or every runner of the repo
#   gh-runner list                        # containers on the host and runners on GitHub
#   gh-runner upgrade                     # copies the files again, rebuilds, recreates
#   gh-runner use <owner/repo> hosted|self  # where the repo's CI runs (CI_RUNS_ON variable)
#   gh-runner logs <owner/repo> <index>
#   gh-runner ssh
#
# GH_RUNNER_HOST is the SSH destination of the host (default: the `gh-runner` alias of
# ~/.ssh/config).
set -euo pipefail

host="${GH_RUNNER_HOST:-gh-runner}"
remote_dir=/opt/gh-runner
here="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
# Labels of the runners on the host (see GH_RUNNER_LABELS in runnerctl); `use self` targets them.
self_hosted_runs_on='["self-hosted","oracle"]'

remote() { ssh "$host" "$@"; }

die() {
  echo "$*" >&2
  exit 1
}

check_repo() {
  [[ "${1:-}" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die "Expected <owner/repo>, got '${1:-}'."
}

sync_files() {
  remote "sudo mkdir -p $remote_dir && sudo chown \$(id -un): $remote_dir"
  rsync -a --delete "$here/host/" "$host:$remote_dir/"
  remote "sudo ln -sf $remote_dir/runnerctl /usr/local/bin/runnerctl"
}

token() {
  gh api -X POST "repos/$1/actions/runners/$2" --jq .token
}

case "${1:-}" in
  setup)
    sync_files
    remote "sudo bash $remote_dir/host-setup.sh"
    # A fresh login picks up the docker group that host-setup.sh just granted.
    remote "runnerctl build"
    ;;
  add)
    check_repo "${2:-}"
    repo="$2"
    count="${3:-1}"
    last="$(remote "runnerctl indexes $repo" | tail -n1)"
    for ((i = ${last:-0} + 1; i <= ${last:-0} + count; i++)); do
      echo "Registering runner $i of $repo..."
      token "$repo" registration-token | remote "runnerctl register $repo $i"
    done
    ;;
  remove)
    check_repo "${2:-}"
    repo="$2"
    if [[ -n "${3:-}" ]]; then
      indexes=("$3")
    else
      mapfile -t indexes < <(remote "runnerctl indexes $repo")
    fi
    [[ ${#indexes[@]} -gt 0 ]] || die "$repo has no runners on $host."
    for i in "${indexes[@]}"; do
      echo "Removing runner $i of $repo..."
      token "$repo" remove-token | remote "runnerctl remove $repo $i"
    done
    ;;
  list)
    remote "runnerctl list"
    echo
    while read -r repo; do
      gh api "repos/$repo/actions/runners" \
        --jq ".runners[] | \"$repo  \(.name)  \(.status)  busy=\(.busy)\""
    done < <(remote "docker ps -a --filter label=gh-runner.repo --format '{{.Label \"gh-runner.repo\"}}'" | sort -u)
    ;;
  upgrade)
    sync_files
    remote "runnerctl upgrade"
    ;;
  use)
    check_repo "${2:-}"
    case "${3:-}" in
      hosted) gh variable delete CI_RUNS_ON --repo "$2" 2>/dev/null || true ;;
      self) gh variable set CI_RUNS_ON --repo "$2" --body "$self_hosted_runs_on" ;;
      *) die "Usage: gh-runner use <owner/repo> hosted|self" ;;
    esac
    echo "$2 now runs CI on: $(gh variable get CI_RUNS_ON --repo "$2" 2>/dev/null || echo 'GitHub-hosted (default)')"
    ;;
  logs)
    check_repo "${2:-}"
    remote -t "runnerctl logs $2 ${3:?index}"
    ;;
  ssh)
    shift
    ssh "$host" "$@"
    ;;
  *)
    sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'
    exit 2
    ;;
esac
