# Copy to .env and fill in. README.md explains each variable.

# GitHub App (recommended): short-lived tokens, limited to the repos it is installed on.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=/run/secrets/github-app.pem
# Only needed when the app has more than one installation.
GITHUB_APP_INSTALLATION_ID=

# Or a fine-grained token with Administration (write) and Actions (read) on the repos.
# GITHUB_TOKEN=

# Tells pools on the same Docker host apart and prefixes runner names: pc, oracle-sp...
POOL_NAME=pc
POOL_SIZE=6
POOL_LABELS=gh-runner
RUNNER_CPUS=4
RUNNER_MEMORY=8g

POLL_INTERVAL=5s
IDLE_TIMEOUT=5m
REPO_REFRESH=5m
REPOS_INCLUDE=
REPOS_EXCLUDE=
ALLOW_PUBLIC_REPOS=false
LOG_LEVEL=info
